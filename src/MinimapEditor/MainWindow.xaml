<Window x:Class="MinimapEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinimapEditor"
        xmlns:vm="clr-namespace:MinimapEditor.Viewmodels"
        Icon="/Content/hammer256.png"
        xmlns:resources="clr-namespace:MinimapEditor.Resources"
        mc:Ignorable="d"
        MinHeight="500" MinWidth="1050" Background="#202020"
        Title="{Binding WindowTitle8643}" SizeChanged="RecalculateSize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ReadmeViewmodel}">
            <local:ReadmeControl></local:ReadmeControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewmodel}">
            <local:StartupControl></local:StartupControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapEditorViewmodel}">
            <local:MapEditorControl></local:MapEditorControl>
        </DataTemplate>

    </Window.Resources>
    <DockPanel>
        <Menu VerticalAlignment="Top" DockPanel.Dock="Top" Background="Black" Foreground="White" Padding="3">
            <MenuItem Header="File">
                <MenuItem Header="Open CMNDAT" Padding="2" FontWeight="Normal" Command="{Binding CommandBrowse1907}"/>
                <MenuItem Header="Save As..." Padding="2" FontWeight="Normal" IsEnabled="{Binding CanSave8786}" Click="SaveCmndatAs_Click"/>
                <MenuItem Header="Close CMNDAT" Padding="2" FontWeight="Normal" Command="{Binding CommandClose5823}"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid Margin="40,0">
                <TextBlock Margin="0,0,0,0" Text="············································································································································································································································" VerticalAlignment="Top" Foreground="Gray" HorizontalAlignment="Center" FontSize="22" FontWeight="ExtraLight"/>
            </Grid>
                <TabControl Background="#202020"  BorderThickness="0" x:Name="mainTabControl" ItemsSource="{Binding Tabs4685}" SelectedItem="{Binding SelectedTab4149}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </TabControl.Resources>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <resources:OutlinedTextControl Text="{Binding Header5924}" TextWeight = "Bold" Width="{Binding MyWidth}" Height="20" FontSize="16" StrokeThickness="3"></resources:OutlinedTextControl>
                        <Button Command="{Binding CommandCloseTab2176}" Padding="0" Background="Transparent" BorderThickness="0"
                            Margin="5,0,0,0" Width="16" Height="16" VerticalContentAlignment="Center">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanCloseTab4739}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Stroke="#666" StrokeThickness="1.5" Stretch="Uniform"
                              Width="12" Height="12"
                              Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Viewmodel2249}" DataContextChanged="ContentControl_DataContextChanged"></ContentControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
            </Grid>
    </DockPanel>
</Window>
